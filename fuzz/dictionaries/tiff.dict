# TIFF/DNG tokens for open_decode and tiff_parse (little-endian tag ids, field types).
# Use: cargo +nightly fuzz run open_decode -- -dict=dictionaries/tiff.dict
magic_le="II*\x00"
magic_be="MM\x00*"
tag_image_width="\x00\x01"
tag_image_length="\x01\x01"
tag_bits_per_sample="\x02\x01"
tag_compression="\x03\x01"
tag_samples_per_pixel="\x15\x01"
tag_rows_per_strip="\x16\x01"
tag_strip_offsets="\x11\x01"
tag_strip_byte_counts="\x17\x01"
tag_predictor="\x3d\x01"
tag_tile_width="\x42\x01"
tag_tile_length="\x43\x01"
tag_tile_offsets="\x44\x01"
tag_tile_byte_counts="\x45\x01"
tag_sample_format="\x53\x01"
tag_sub_ifds="\x4a\x01"
tag_dng_version="\x12\xc6"
tag_opcode_list_2="\x8a\x74"
type_short="\x03\x00"
type_long="\x04\x00"
deflate_compression="\x08\x00"
lossless_jpeg_compression="\x07\x00"
tile_65535="\xff\xff\x00\x00"
tile_max="\xff\xff\xff\xff"
count_huge="\x00\x00\x00\x40"
zlib_header="\x78\x01"
zlib_header_best="\x78\xda"
